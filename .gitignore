# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Editor
.vscode/
.idea/
.DS_Store

# Keep raw downloads out of git by default (large / re-fetchable).
# Comment the next line if you want to commit a frozen snapshot.
data/raw/*
!data/raw/.gitkeep
# hand-curated, not re-fetchable — keep in git:
!data/raw/manual_events.csv
!data/raw/dangerous_lakes.csv
!data/raw/curated_reaches.json

# Processed outputs ARE committed: Pages serves them directly and they double
# as the project's read-only API. ~39 MB, and data/processed/corridors/ is
# 4,617 small files — slow to clone, but it means the site needs no server and
# no pipeline run to work.
!data/processed/
